@model IEnumerable<WebDoDienTu.Models.ProductReview>

@{
    ViewData["Title"] = "ManageReviews";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<main>
    <div class="container-fluid px-4">
        <h1 class="mt-4">Danh mục</h1>
        <ol class="breadcrumb mb-4">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Home" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item active">Danh mục</li>
        </ol>
        <div class="card mb-4">
            <div class="card-body">
                <button id="addProduct" type="submit" class="btn btn-primary">
                    <a asp-action="Create" style="text-decoration: none; color: white">Thêm danh mục</a>
                </button>
            </div>
        </div>
        <div class="card mb-4">
            <div class="card-header">
                <i class="fas fa-table me-1"></i>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <table id="datatablesSimple">
                        <thead>
                            <tr>
                                <th style="text-align: center;">Người dùng</th>
                                <th style="text-align: center;">Nội dung</th>
                                <th style="text-align: center;">Đánh giá</th>
                                <th style="text-align: center;">Email</th>
                                <th style="text-align: center;">Cảm xúc</th>
                                <th style="text-align: center;">Thời gian</th>
                                <th style="text-align: center;">Trạng thái</th>
                                <th style="text-align: center;">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td style="text-align: center;">
                                        @Html.DisplayFor(modelItem => item.YourName)
                                    </td>
                                    <td style="text-align: center;">
                                        @Html.DisplayFor(modelItem => item.Comment)
                                    </td>
                                    <td style="text-align: center;">
                                        @Html.DisplayFor(modelItem => item.Rating)
                                    </td>
                                    <td style="text-align: center;">
                                        @Html.DisplayFor(modelItem => item.YourEmail)
                                    </td>
                                    <td style="text-align: center;">
                                        @(item.Emotion ?? "Không có cảm xúc")
                                    </td>
                                    <td style="text-align: center;">
                                        @Html.DisplayFor(modelItem => item.ReviewDate)
                                    </td>
                                    <td style="text-align: center;">
                                        @(item.IsHidden ? "Ẩn" : "Hiển thị")
                                    </td>
                                    <td style="text-align: center;">
                                        <form asp-action="ToggleReviewVisibility" method="post">
                                            <input type="hidden" name="reviewId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-secondary">
                                                @(item.IsHidden ? "Hiển thị" : "Ẩn")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>Không có đánh giá nào để hiển thị.</p>
                }
            </div>
        </div>
    </div>
</main>